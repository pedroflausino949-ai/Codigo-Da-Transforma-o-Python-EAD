def menu_biblioteca():
    while True:
        print("\n" + "=" * 50)
        print("SISTEMA DE BIBLIOTECA")
        print("=" * 50)
        print("1 - Adicionar livro")
        print("2 - Listar livros")
        print("3 - Buscar livro")
        print("4 - Emprestar livro")
        print("5 - Devolver livro")
        print("6 - Listar emprestimos")
        print("0 - Voltar")
        print("=" * 50)

        opcao = input("Escolha uma opcao: ").strip()

        if opcao == "1":
            titulo = input("Titulo: ").strip()
            autor = input("Autor: ").strip()

            if titulo == "" or autor == "":
                print("Preencha todos os campos.")
            else:
                biblioteca.adicionar_livro(Livro(titulo, autor))

        elif opcao == "2":
            biblioteca.listar_livros()

        elif opcao == "3":
            titulo = input("Digite o titulo: ").strip()
            livro = biblioteca.buscar_livro(titulo)

            if livro is None:
                print("Livro nao encontrado.")
            else:
                print("Livro encontrado:", livro)

        elif opcao == "4":
            titulo = input("Titulo do livro: ").strip()
            pessoa = input("Nome da pessoa: ").strip()

            if pessoa == "":
                print("Digite o nome da pessoa.")
            else:
                biblioteca.emprestar_livro(titulo, pessoa)

        elif opcao == "5":
            titulo = input("Titulo do livro: ").strip()
            biblioteca.devolver_livro(titulo)

        elif opcao == "6":
            biblioteca.listar_emprestimos()

        elif opcao == "0":
            print("Voltando ao menu principal...")
            break

        else:
            print("Opcao invalida.")



